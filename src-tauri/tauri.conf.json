{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DB Studio",
  "version": "0.1.4",
  "identifier": "com.dbstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run build:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DB Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1060,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 165,
          "y": 169
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 169
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
